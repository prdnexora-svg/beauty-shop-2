# ---------------------------------------------------------------------------
# NEXORA LUXE — environment variables
# ---------------------------------------------------------------------------
# Every variable here is prefixed with VITE_ on purpose: Vite inlines these
# into the browser bundle at BUILD TIME, so they must exist before
# `npm run build` runs. On Vercel that means adding them under
# Project Settings -> Environment Variables and then redeploying.
#
# The app boots without them — it falls back to the local demo/seed database
# (see src/db/database.ts) and shows "Supabase not configured" in the
# in-app database status modal. Nothing crashes.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://qwaehqsmodekbgvnaavz.supabase.co
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"

# Public anon key. Safe to ship to the browser — Row Level Security is the
# authorization boundary. NEVER put the service_role key here or anywhere in
# this repo.
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# Namespaces the auth session in localStorage so multiple apps on one origin
# do not collide. Change only if you run several Nexora apps side by side.
VITE_SUPABASE_STORAGE_KEY="nexora.auth.qwaehqsmodekbgvnaavz"

# ---------------------------------------------------------------------------
# Sign-in channels (all optional — sensible defaults for this India-first app)
# ---------------------------------------------------------------------------
# Mobile OTP is only as good as the SMS provider attached to the Supabase
# project. Until one exists under
#   Authentication -> Sign In / Providers (OTP) -> Phone
# GoTrue answers EVERY /auth/v1/otp request with:
#   "Unsupported phone provider"
# That is a project setting, not a bug in this app. The sign-in flow now
# detects it, explains it, and offers email / password / Google instead of a
# dead end — but someone still has to choose a path:
#   a) configure Twilio, Twilio Verify, MessageBird, Vonage or TextLocal in
#      the dashboard (in India, complete DLT template + header registration
#      first, or messages are accepted and never delivered), or
#   b) set VITE_AUTH_PHONE_OTP_ENABLED="false" to drop the SMS option.
#
# Local development without any provider: in supabase/config.toml set
#   [auth.sms] enabled = true
#   [auth.sms.test_otp] 919820154321 = "123456"
# (remove before production).
# Hide the text-message sign-in path entirely. Default: true.
VITE_AUTH_PHONE_OTP_ENABLED="true"

# Dialling code used to complete numbers typed without one, so
# "09820154321" / "9820154321" become "+919820154321" (GoTrue requires E.164).
VITE_AUTH_DEFAULT_COUNTRY_CODE="91"

# Phone OTP delivery channel: sms | whatsapp. WhatsApp requires a Twilio or
# Twilio Verify provider with an approved WhatsApp sender. Default: sms.
VITE_AUTH_OTP_CHANNEL="sms"
